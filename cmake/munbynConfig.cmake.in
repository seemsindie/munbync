@PACKAGE_INIT@

# Include the targets file
include("${CMAKE_CURRENT_LIST_DIR}/munbynTargets.cmake")

# Check for required components
set(_munbyn_supported_components munbyn)
set(munbyn_munbyn_FOUND TRUE)

foreach(_comp ${munbyn_FIND_COMPONENTS})
    if(NOT _comp IN_LIST _munbyn_supported_components)
        set(munbyn_FOUND False)
        set(munbyn_NOT_FOUND_MESSAGE "Unsupported component: ${_comp}")
    endif()
endforeach()

# Provide the variables that users expect
set(MUNBYN_LIBRARIES munbyn::munbyn)
set_and_check(MUNBYN_INCLUDE_DIRS "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set(MUNBYN_VERSION "@PROJECT_VERSION@")

# Check that the targets are available
check_required_components(munbyn)
set(MUNBYN_FOUND ${munbyn_FOUND})
